{
  "buildCommand": "node scripts/vercel_build.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(css|javaScript|img|uploads)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/(manifest\\.json|sw\\.js)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
