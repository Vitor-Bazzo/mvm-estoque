{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/(css|javaScript|img|uploads)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(manifest\\.json|sw\\.js)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
